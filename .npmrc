# React Native / Expo do not understand pnpm's strict symlinked layout for
# transitive dependencies (Metro can't resolve hoisted babel runtime, whatwg-fetch,
# etc.). Use the hoisted node-linker so node_modules is flat, like npm.
node-linker=hoisted
shamefully-hoist=true

# Allow esbuild and similar to run install scripts (Expo needs this).
auto-install-peers=true
