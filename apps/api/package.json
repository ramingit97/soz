{
  "name": "@soz/api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "node scripts/build.mjs",
    "start": "node --enable-source-maps dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test --experimental-test-module-mocks \"src/**/*.test.ts\"",
    "start:tsx": "tsx src/index.ts",
    "migrate": "tsx src/db/migrate.ts"
  },
  "dependencies": {
    "@deepgram/sdk": "^3.9.0",
    "@hono/node-server": "^1.13.7",
    "@hono/zod-validator": "^0.4.1",
    "@sentry/node": "^10.52.0",
    "@soz/content": "workspace:*",
    "@soz/shared-types": "workspace:*",
    "bcryptjs": "^3.0.3",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.6.12",
    "jose": "^6.2.3",
    "openai": "^6.36.0",
    "postgres": "^3.4.9",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^22.9.0",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "esbuild": "^0.27.7"
  }
}
