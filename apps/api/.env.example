PORT=3000
NODE_ENV=development

# OpenAI (LLM + STT fallback + TTS fallback)
OPENAI_API_KEY=
# Which model does what — see src/ai/models.ts. Override without a rebuild.
#   CHAT: what the child hears (Bobo's replies, the opener). Default gpt-5.6-terra.
#   FAST: JSON for the code (safety screen, memory, interests, photo, songs,
#         analysis). Default gpt-4o-mini.
#   GENERATOR: week/curriculum generation. Default gpt-4o.
OPENAI_CHAT_MODEL=
OPENAI_FAST_MODEL=
OPENAI_GENERATOR_MODEL=

# Daily AI spend alert (USD). When the day's estimated total crosses this,
# the server logs an error and pings Sentry once. Soft — calls are not refused.
AI_DAILY_BUDGET_USD=20

# Deepgram (STT — strict single-language calls, e.g. word-check)
DEEPGRAM_API_KEY=

# ElevenLabs (TTS — Bobo's voice)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID_EN=
ELEVENLABS_VOICE_ID_RU=

# Database
DATABASE_URL=

# Redis (not yet used — the rate limiter is in-process; see middleware/rateLimit.ts)
REDIS_URL=

# Auth
JWT_SECRET=change-me

# Transactional email (Resend). REQUIRED in production: without it sendEmail()
# only logs to stdout and returns ok, so password reset silently does nothing.
RESEND_API_KEY=
# Sender — MUST be on a domain verified in Resend; gmail.com is rejected.
RESEND_FROM=Söz <hello@YOUR-DOMAIN>
# Human inbox for replies (can be any address, gmail is fine here).
RESEND_REPLY_TO=

# RevenueCat webhook (Integrations → Webhooks → Authorization header value).
# REQUIRED in production: this is the only thing that writes users.premium_until,
# so without it no subscription is ever recorded server-side.
REVENUECAT_WEBHOOK_SECRET=

# Child-safety triage. REQUIRED in production: every crisis flagged by the
# real-time screen emails a copy here with the category (no transcript), in
# addition to the parent. This is the ONLY path that surfaces a crisis on a guest
# trial, whose synthetic @guest.invalid address can receive nothing.
SAFETY_OPERATOR_EMAIL=

# How long conversation transcripts are kept (privacy policy says 90).
TRANSCRIPT_RETENTION_DAYS=90

# Error monitoring (optional)
SENTRY_DSN=
